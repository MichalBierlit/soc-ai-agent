# ==============================================================================
# SOC AI Threat Intelligence Platform — Environment Configuration
# ==============================================================================
# Skopiuj ten plik do .env i uzupełnij swoimi wartościami:
#   cp .env.example .env

# --- Groq AI (Wymagany do modułów AI, Threat Hunting Text-to-SQL i SOAR Playbooków) ---
# Uzyskaj bezpłatny klucz na: https://console.groq.com
GROQ_API_KEY=twoj_klucz_groq_tutaj

# Domyślny model Groq (np. qwen/qwen3.8-27b lub llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# --- VirusTotal API (Opcjonalny, do analizy hashy złośliwych plików w zakładce DFIR) ---
# Uzyskaj klucz na: https://www.virustotal.com
VT_API_KEY=twoj_klucz_virustotal_tutaj

# --- AbuseIPDB API (Do weryfikacji reputacji publicznych adresów IP) ---
# Uzyskaj bezpłatny klucz na: https://www.abuseipdb.com
ABUSEIPDB_API_KEY=twoj_klucz_abuseipdb_tutaj

# --- Discord Webhook (Opcjonalnie, do automatycznych alertów i podsumowań SOC) ---
# Można skonfigurować tutaj lub bezpośrednio w interfejsie Streamlit
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/TWOJ_WEBHOOK_URL

# --- Połączenie z bazą PostgreSQL (Opcjonalne, domyślnie dopasowuje się do środowiska) ---
# Na maszynie lokalnej (poza Dockerem):
# DATABASE_URL=postgresql://postgres:admin_password@localhost:5433/soc_db
# Wewnątrz kontenera Docker (ustawiane automatycznie przez docker-compose):
# DATABASE_URL=postgresql://postgres:admin_password@db:5432/soc_db
